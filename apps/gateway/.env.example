# Copy to .env locally and replace placeholders. Never commit populated .env files.
HUB_HOST=127.0.0.1
HUB_PORT=4782
CF_ACCESS_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
CF_ACCESS_AUD=REPLACE_WITH_PRIVATE_ACCESS_AUDIENCE
CF_ACCESS_ALLOWED_EMAIL=owner@example.invalid
PUBLIC_ORIGIN=https://terminal.example.invalid
PROJECT_ROOTS=/Users/REPLACE_ME/Projects
TMUX_BIN=/opt/homebrew/bin/tmux
CODEX_BIN=/opt/homebrew/bin/codex
CLAUDE_BIN=/opt/homebrew/bin/claude
PI_BIN=/opt/homebrew/bin/pi
# Optional path to a separately built UI directory. All assets still require Access JWT.
# HUB_WEB_ROOT=/absolute/path/to/apps/web/dist
